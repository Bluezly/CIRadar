CIRADAR_PUBLIC_BASE_URL=https://ciradar.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
CIRADAR_MASTER_KEY=replace-with-output-of-ciradar-secret-key
CIRADAR_DATABASE_URL=postgres://ciradar:replace-with-password@postgres:5432/ciradar?sslmode=verify-full
CIRADAR_DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
CIRADAR_MARKETPLACE_WEBHOOK_SECRET=replace-with-github-marketplace-webhook-secret
CIRADAR_SSO_SESSION_SECRET=replace-with-at-least-32-random-bytes
CIRADAR_SSO_CLIENT_SECRET=replace-with-oidc-client-secret
