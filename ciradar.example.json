{
  "listen_address": "127.0.0.1:8787",
  "database_driver": "embedded",
  "database_path": ".ciradar/ciradar-state.json",
  "data_directory": ".ciradar",
  "rules_directory": "rules",
  "log_level": "info",
  "retention_days": 30,
  "store_redacted_excerpts": true,
  "store_raw_logs": false,
  "cross_tenant_correlation": false,
  "incident_window": "15m",
  "incident_repo_threshold": 3,
  "incident_org_threshold": 2,
  "worker_count": 2,
  "max_log_bytes": 33554432,
  "provider_polling": true,
  "provider_poll_interval": "2m",
  "automatic_retry_enabled": false,
  "automatic_retry_min_score": 85,
  "github_app_id": 0,
  "github_private_key_path": "",
  "github_webhook_secret": "",
  "github_api_url": "https://api.github.com",
  "require_github_installation_binding": true,
  "public_base_url": "",
  "fingerprint_hmac_key": "REPLACE_WITH_32_BYTE_BASE64_HMAC_KEY",
  "admin_token": "REPLACE_WITH_LONG_RANDOM_ROOT_TOKEN",
  "default_tenant_id": "default",
  "allow_unauthenticated_localhost": false,
  "trusted_proxy_cidrs": [
    "127.0.0.0/8",
    "::1/128"
  ],
  "dashboard_enabled": true,
  "dashboard_session_secret": "env:CIRADAR_DASHBOARD_SESSION_SECRET",
  "dashboard_cookie_secure": true,
  "redaction_patterns": [],
  "redaction_entropy_detection": true,
  "github_marketplace": {
    "enabled": false,
    "webhook_secret": "env:CIRADAR_MARKETPLACE_WEBHOOK_SECRET",
    "auto_create_tenant": true,
    "cancellation_policy": "retain_free",
    "free_plan_name": "free"
  },
  "incident_resolve_after": "30m",
  "notifications": {
    "enabled": false,
    "channels": [
      {
        "name": "slack-ops",
        "type": "slack",
        "enabled": false,
        "events": [
          "analysis",
          "environment_changed",
          "incident_opened",
          "incident_updated",
          "incident_resolved",
          "test_flaky",
          "repair_pr_created"
        ],
        "minimum_score": 60,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "url": "env:CIRADAR_SLACK_WEBHOOK",
        "allow_private_network": false
      },
      {
        "name": "discord-ops",
        "type": "discord",
        "enabled": false,
        "events": [
          "analysis",
          "environment_changed",
          "incident_opened",
          "incident_updated",
          "incident_resolved",
          "test_flaky",
          "repair_pr_created"
        ],
        "minimum_score": 60,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "url": "env:CIRADAR_DISCORD_WEBHOOK",
        "allow_private_network": false
      },
      {
        "name": "telegram-ops",
        "type": "telegram",
        "enabled": false,
        "events": [
          "analysis",
          "environment_changed",
          "incident_opened",
          "incident_updated",
          "incident_resolved",
          "test_flaky",
          "repair_pr_created"
        ],
        "minimum_score": 60,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "bot_token": "env:CIRADAR_TELEGRAM_BOT_TOKEN",
        "chat_id": "env:CIRADAR_TELEGRAM_CHAT_ID",
        "allow_private_network": false
      },
      {
        "name": "custom-webhook",
        "type": "webhook",
        "enabled": false,
        "events": [
          "analysis",
          "environment_changed",
          "incident_opened",
          "incident_updated",
          "incident_resolved",
          "test_flaky",
          "repair_pr_created"
        ],
        "minimum_score": 60,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "allow_private_network": false
      },
      {
        "name": "teams-ops",
        "type": "teams",
        "enabled": false,
        "events": [
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_score": 70,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "url": "env:CIRADAR_TEAMS_WEBHOOK",
        "allow_private_network": false
      },
      {
        "name": "pagerduty-ops",
        "type": "pagerduty",
        "enabled": false,
        "events": [
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_severity": "major",
        "cooldown": "5m",
        "timeout": "10s",
        "max_attempts": 5,
        "routing_key": "env:CIRADAR_PAGERDUTY_ROUTING_KEY",
        "allow_private_network": false
      },
      {
        "name": "opsgenie-ops",
        "type": "opsgenie",
        "enabled": false,
        "events": [
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_severity": "major",
        "cooldown": "5m",
        "timeout": "10s",
        "max_attempts": 5,
        "api_key": "env:CIRADAR_OPSGENIE_API_KEY",
        "allow_private_network": false
      },
      {
        "name": "email-ops",
        "type": "email",
        "enabled": false,
        "events": [
          "analysis",
          "incident_opened",
          "incident_resolved",
          "test_flaky",
          "repair_pr_created"
        ],
        "minimum_score": 75,
        "cooldown": "15m",
        "timeout": "15s",
        "max_attempts": 5,
        "smtp_port": 587,
        "smtp_mode": "starttls",
        "smtp_host": "smtp.example.com",
        "smtp_username": "env:CIRADAR_SMTP_USERNAME",
        "smtp_password": "env:CIRADAR_SMTP_PASSWORD",
        "email_from": "ci-radar@example.com",
        "email_to": [
          "platform@example.com"
        ],
        "allow_private_network": false
      }
    ]
  },
  "pr_comments": {
    "enabled": true,
    "mode": "external_or_strong",
    "minimum_score": 60,
    "update_existing": true
  },
  "connectors": [
    {
      "name": "gitlab",
      "provider": "gitlab",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://gitlab.com",
      "token": "",
      "webhook_secret": "",
      "allow_private_network": false
    },
    {
      "name": "buildkite",
      "provider": "buildkite",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://api.buildkite.com",
      "token": "",
      "webhook_secret": "",
      "allow_private_network": false
    },
    {
      "name": "circleci",
      "provider": "circleci",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://circleci.com",
      "token": "",
      "webhook_secret": "",
      "allow_private_network": false
    },
    {
      "name": "jenkins",
      "provider": "jenkins",
      "enabled": false,
      "tenant_id": "default",
      "token": "",
      "webhook_secret": "",
      "allow_private_network": false
    },
    {
      "name": "azuredevops",
      "provider": "azuredevops",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://dev.azure.com/YOUR_ORGANIZATION",
      "organization": "YOUR_ORGANIZATION",
      "project": "YOUR_PROJECT",
      "token": "env:CIRADAR_AZURE_DEVOPS_PAT",
      "webhook_secret": "env:CIRADAR_AZURE_WEBHOOK_TOKEN",
      "allow_private_network": false
    },
    {
      "name": "bitrise",
      "provider": "bitrise",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://api.bitrise.io",
      "token": "env:CIRADAR_BITRISE_TOKEN",
      "webhook_secret": "env:CIRADAR_BITRISE_WEBHOOK_TOKEN",
      "allow_private_network": false
    },
    {
      "name": "teamcity",
      "provider": "teamcity",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://teamcity.example.com",
      "token": "env:CIRADAR_TEAMCITY_TOKEN",
      "webhook_secret": "env:CIRADAR_TEAMCITY_WEBHOOK_TOKEN",
      "allow_private_network": false
    },
    {
      "name": "travis",
      "provider": "travis",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://api.travis-ci.com",
      "token": "env:CIRADAR_TRAVIS_TOKEN",
      "webhook_secret": "env:CIRADAR_TRAVIS_WEBHOOK_TOKEN",
      "allow_private_network": false
    },
    {
      "name": "codebuild",
      "provider": "codebuild",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://codebuild.amazonaws.com",
      "region": "us-east-1",
      "webhook_secret": "env:CIRADAR_CODEBUILD_WEBHOOK_TOKEN",
      "allow_private_network": false
    },
    {
      "name": "bitbucket",
      "provider": "bitbucket",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://api.bitbucket.org",
      "token": "env:CIRADAR_BITBUCKET_TOKEN",
      "webhook_secret": "env:CIRADAR_BITBUCKET_WEBHOOK_SECRET",
      "allow_private_network": false
    },
    {
      "name": "drone",
      "provider": "drone",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://cloud.drone.io",
      "token": "env:CIRADAR_DRONE_TOKEN",
      "webhook_secret": "env:CIRADAR_DRONE_WEBHOOK_SECRET",
      "allow_private_network": false
    },
    {
      "name": "semaphore",
      "provider": "semaphore",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://api.semaphoreci.com",
      "token": "env:CIRADAR_SEMAPHORE_TOKEN",
      "webhook_secret": "env:CIRADAR_SEMAPHORE_WEBHOOK_SECRET",
      "allow_private_network": false
    },
    {
      "name": "appveyor",
      "provider": "appveyor",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://ci.appveyor.com",
      "token": "env:CIRADAR_APPVEYOR_TOKEN",
      "webhook_secret": "env:CIRADAR_APPVEYOR_WEBHOOK_SECRET",
      "allow_private_network": false
    },
    {
      "name": "cloudbuild",
      "provider": "cloudbuild",
      "enabled": false,
      "tenant_id": "default",
      "base_url": "https://cloudbuild.googleapis.com",
      "token": "env:CIRADAR_CLOUDBUILD_TOKEN",
      "webhook_secret": "env:CIRADAR_CLOUDBUILD_WEBHOOK_SECRET",
      "allow_private_network": false
    }
  ],
  "test_intelligence": {
    "enabled": true,
    "auto_quarantine": false,
    "auto_quarantine_min_runs": 5,
    "auto_quarantine_min_score": 65,
    "auto_quarantine_duration": "7d"
  },
  "database_url": "",
  "source_url": "https://your-git-host.example/your-org/ci-radar/tree/EXACT_COMMIT",
  "sso": {
    "enabled": false,
    "mode": "oidc",
    "issuer_url": "https://identity.example.com",
    "client_id": "ci-radar",
    "client_secret": "env:CIRADAR_SSO_CLIENT_SECRET",
    "redirect_url": "https://ci-radar.example.com/auth/callback",
    "scopes": [
      "openid",
      "profile",
      "email"
    ],
    "allowed_domains": [
      "example.com"
    ],
    "tenant_claim": "tenant_id",
    "role_claim": "role",
    "groups_claim": "groups",
    "admin_groups": [
      "ci-radar-admins"
    ],
    "operator_groups": [
      "ci-radar-operators"
    ],
    "viewer_groups": [
      "ci-radar-viewers"
    ],
    "default_tenant": "default",
    "default_role": "viewer",
    "session_secret": "env:CIRADAR_SSO_SESSION_SECRET",
    "cookie_name": "ciradar_session",
    "cookie_secure": true,
    "trusted_proxy_cidrs": [
      "127.0.0.0/8"
    ],
    "proxy_secret_header": "X-CI-Radar-Proxy-Secret",
    "proxy_secret": "env:CIRADAR_SSO_PROXY_SECRET",
    "saml_entity_id": "https://ci-radar.example.com/saml/metadata",
    "saml_idp_sso_url": "https://identity.example.com/saml/sso",
    "saml_idp_entity_id": "https://identity.example.com/metadata",
    "saml_idp_certificate": "/run/secrets/idp-signing-cert.pem",
    "saml_acs_url": "https://ci-radar.example.com/auth/callback",
    "saml_xmlsec_path": "/usr/bin/xmlsec1",
    "saml_security_profile": "strict",
    "saml_name_attribute": "name",
    "saml_email_attribute": "email",
    "saml_clock_skew": "2m",
    "allow_private_network": false
  },
  "llm": {
    "enabled": false,
    "provider": "openai-compatible",
    "endpoint": "https://api.example.com/v1/chat/completions",
    "api_key": "env:CIRADAR_LLM_API_KEY",
    "model": "YOUR_MODEL",
    "embeddings_endpoint": "https://api.example.com/v1/embeddings",
    "embedding_model": "YOUR_EMBEDDING_MODEL",
    "auto_enhance": false,
    "minimum_score": 60,
    "max_input_characters": 24000,
    "max_output_tokens": 1200,
    "timeout": "45s",
    "send_redacted_excerpt": true,
    "send_changed_files": true,
    "send_source_code": false,
    "data_policy": "redacted_remote",
    "block_on_residual_secret": true,
    "allow_remote_source_code": false,
    "allow_private_network": false
  },
  "chatops": {
    "enabled": false,
    "default_tenant": "default",
    "slack_signing_secret": "env:CIRADAR_SLACK_SIGNING_SECRET",
    "slack_allowed_users": [],
    "slack_allowed_teams": [],
    "teams_signing_secret": "env:CIRADAR_TEAMS_SIGNING_SECRET",
    "teams_allowed_users": [],
    "allow_acknowledge": true,
    "allow_resolve": true,
    "allow_quarantine": true,
    "quarantine_duration": "7d"
  },
  "costs": {
    "enabled": true,
    "currency": "USD",
    "default_rates": {
      "github": 0.008,
      "gitlab": 0,
      "azuredevops": 0,
      "buildkite": 0,
      "circleci": 0,
      "jenkins": 0,
      "bitrise": 0,
      "teamcity": 0,
      "travis": 0,
      "codebuild": 0,
      "bitbucket": 0,
      "drone": 0,
      "semaphore": 0,
      "appveyor": 0,
      "cloudbuild": 0
    },
    "runner_rates": {
      "ubuntu-latest": 0.008,
      "windows-latest": 0.016,
      "macos-latest": 0.08
    },
    "billing_rounds": {}
  },
  "semantic_similarity": {
    "enabled": true,
    "remote_embeddings": false,
    "vector_dimensions": 256,
    "candidate_limit": 1000,
    "mode": "ollama",
    "local_endpoint": "http://127.0.0.1:11434/api/embed",
    "local_model": "embeddinggemma",
    "local_api_key": "",
    "local_vector_path": ""
  },
  "predictive_tests": {
    "enabled": true,
    "default_limit": 200,
    "minimum_score": 20,
    "always_run_flaky": true,
    "always_run_failed": true
  },
  "repair": {
    "enabled": false,
    "auto_draft_pr": false,
    "minimum_score": 60,
    "branch_prefix": "ciradar/repair-",
    "maximum_files": 10,
    "maximum_lines": 1000
  },
  "github_allow_private_network": false
}
