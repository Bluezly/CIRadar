{
  "listen_address": "127.0.0.1:8787",
  "database_path": ".ciradar/ciradar-state.json",
  "data_directory": ".ciradar",
  "rules_directory": "rules",
  "log_level": "info",
  "retention_days": 30,
  "store_redacted_excerpts": true,
  "store_raw_logs": false,
  "cross_repository_sharing": false,
  "incident_window": "15m",
  "incident_repo_threshold": 3,
  "incident_org_threshold": 2,
  "worker_count": 2,
  "max_log_bytes": 33554432,
  "provider_polling": true,
  "provider_poll_interval": "2m",
  "automatic_retry_enabled": false,
  "automatic_retry_min_score": 85,
  "github_app_id": 0,
  "github_private_key_path": "",
  "github_webhook_secret": "",
  "github_api_url": "https://api.github.com",
  "public_base_url": "",
  "fingerprint_hmac_key": "",
  "admin_token": "",
  "notifications": {
    "enabled": false,
    "channels": [
      {
        "name": "slack-ops",
        "type": "slack",
        "enabled": false,
        "events": [
          "analysis",
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_score": 65,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "url": "https://hooks.slack.com/services/REPLACE/ME",
        "mention": "<!channel>"
      },
      {
        "name": "discord-ops",
        "type": "discord",
        "enabled": false,
        "events": [
          "analysis",
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_score": 65,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "url": "https://discord.com/api/webhooks/REPLACE/ME",
        "username": "CI Radar",
        "mention": "@here"
      },
      {
        "name": "telegram-ops",
        "type": "telegram",
        "enabled": false,
        "events": [
          "analysis",
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_score": 65,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "bot_token": "REPLACE_WITH_BOT_TOKEN",
        "chat_id": "REPLACE_WITH_CHAT_ID",
        "message_thread_id": 0
      },
      {
        "name": "custom-webhook",
        "type": "webhook",
        "enabled": false,
        "events": [
          "analysis",
          "incident_opened",
          "incident_updated",
          "incident_resolved"
        ],
        "minimum_score": 65,
        "cooldown": "15m",
        "timeout": "10s",
        "max_attempts": 5,
        "url": "https://alerts.example.com/ciradar",
        "hmac_secret": "REPLACE_WITH_LONG_RANDOM_SECRET",
        "headers": {
          "X-Environment": "production"
        }
      }
    ]
  }
}
